{
  "name": "geostatlab-public",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "GeoStat Lab: 139 esperimenti interattivi con R e ggplot2, 17 pianeti rotanti e 11 percorsi applicativi.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/check-lint.mjs && node scripts/check-modules.mjs && node scripts/build.mjs && node scripts/check-dist.mjs && node scripts/check-http.mjs && node scripts/check-security.mjs && node scripts/check-consistency.mjs",
    "start": "node scripts/serve.mjs",
    "import": "python3 scripts/import-course.py",
    "render": "python3 scripts/import-course.py --render",
    "test:dom": "node tests/dom.mjs && node tests/security-dom.mjs",
    "test:browser": "python3 tests/browser.py",
    "check:course": "python3 materiali/strumenti/verifica_consegna.py",
    "labs:catalogue": "python3 scripts/labs/build_catalogue.py && Rscript scripts/labs/format-code.R .",
    "labs:check": "Rscript scripts/labs/check-r.R . content/experiments-draft.json edges && Rscript scripts/labs/check-invariants.R .",
    "test:security": "node --test tests/security.test.mjs && node scripts/check-security.mjs",
    "pretest": "node scripts/restore-fixtures.mjs",
    "test:consistency": "node scripts/check-consistency.mjs",
    "docs:modules": "node scripts/update-module-guides.mjs",
    "research:package": "node scripts/package-research.mjs",
    "research:check": "Rscript scripts/check-research.R",
    "lint": "node scripts/check-lint.mjs",
    "format": "prettier --write \"src/*.{js,css}\" \"scripts/*.mjs\" \"tests/*.{mjs,js,cjs}\"",
    "check:modules": "node scripts/check-modules.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
